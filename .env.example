# Slack Configuration
# Get these from: https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# Optional: Channel ID for daily digest (find via right-click on channel > View channel details)
SLACK_DIGEST_CHANNEL_ID=C1234567890

# Optional: Slack user group mentioned for triage of new incidents (e.g. @incident-triage)
# Use the group ID, not the handle. Find it via the usergroups.list API - see
# docs/SLACK_SCOPES_SETUP.md. Keep real workspace IDs out of this file.
SLACK_TRIAGE_GROUP_ID=S01234ABCDE

# Notion Configuration
# Get integration token from: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_your-notion-token-here

# Get database ID from Notion database URL:
# https://www.notion.so/workspace/{workspace-name}/{database-id}?v={view-id}
NOTION_DB_ID=your-database-id-here
NOTION_TEAMS_DB_ID=teams-database-id-here

# Server Configuration
PORT=3000
NODE_ENV=development
